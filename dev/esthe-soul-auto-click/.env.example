# ==============================
# エステ魂 ログイン情報
# ==============================
ESTHE_LOGIN_URL=https://esthe-tama.com/admin/login
ESTHE_ID=your_id_here
ESTHE_PASSWORD=your_password_here

# ==============================
# エステ魂 各エリアの管理ページURL
# (実際のURLに変更してください)
# ==============================
ESTHE_URL_AZABU=https://esthe-tama.com/admin/area/azabu
ESTHE_URL_KANDA=https://esthe-tama.com/admin/area/kanda
ESTHE_URL_NIHONBASHI=https://esthe-tama.com/admin/area/nihonbashi
ESTHE_URL_OMORI=https://esthe-tama.com/admin/area/omori
ESTHE_URL_TAMACHI=https://esthe-tama.com/admin/area/tamachi
ESTHE_URL_HATCHOBORI=https://esthe-tama.com/admin/area/hatchobori

# 集客ワンクリックアピール・リアルタイム集客のURL
ESTHE_URL_APPEAL=https://esthe-tama.com/admin/appeal
ESTHE_URL_REALTIME=https://esthe-tama.com/admin/realtime

# ==============================
# Googleカレンダー ID
# (カレンダー設定 > カレンダーID で確認)
# ==============================
CALENDAR_ID_AZABU=xxxxxxxx@group.calendar.google.com
CALENDAR_ID_KANDA=xxxxxxxx@group.calendar.google.com
CALENDAR_ID_NIHONBASHI=xxxxxxxx@group.calendar.google.com
CALENDAR_ID_OMORI=xxxxxxxx@group.calendar.google.com
CALENDAR_ID_TAMACHI=xxxxxxxx@group.calendar.google.com
# 八丁堀は田町と同じカレンダーを使う場合は田町と同じIDを入力
CALENDAR_ID_HATCHOBORI=xxxxxxxx@group.calendar.google.com
