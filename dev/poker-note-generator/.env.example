# Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxx

# note認証情報（Note Client 2用）
NOTE_EMAIL=your-email@example.com
NOTE_PASSWORD=your-password
NOTE_USER_URL_ID=your-user-id  # noteプロフィールURLの末尾ID

# マガジン設定
NOTE_MAGAZINE_ID=12345  # マガジンID（作成後に設定）
NOTE_ARTICLE_PRICE=500  # 有料記事価格（円）

# スケジューリング
PUBLISH_TIME=09:00  # 投稿時刻（HH:MM）
TIMEZONE=Asia/Tokyo

# PokerNews設定
POKERNEWS_SCRAPE_ENABLED=true
POKERNEWS_API_KEY=  # 将来的にAPI利用する場合

# ログ設定
LOG_LEVEL=INFO
