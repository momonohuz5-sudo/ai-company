# ローカルで手元検証したい場合のみ .env としてコピーして使う（.env自体はコミットしない）。
# 実運用（毎朝のRoutine）では、この環境の「環境変数」設定に同じ変数名で登録する。
# GOOGLE_DRIVE_CLIENT_ID / SECRET / REFRESH_TOKEN はOAuth(デスクトップアプリ)方式で取得したもの
# （組織ポリシーでサービスアカウント鍵が発行できないため採用）。

GEMINI_API_KEY=
GROK_API_KEY=
RETOUCH_API_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=
